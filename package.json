{
  "name": "@local/session-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "All-sessions hub: one searchable, sortable list of every Session across every Workspace.",
  "license": "MIT",
  "author": "20zxknk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/20zxknk/dsh-session-hub.git"
  },
  "homepage": "https://github.com/20zxknk/dsh-session-hub#readme",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "sessions", "workspaces"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
